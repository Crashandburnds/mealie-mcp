# ---------------------------------------------------------------------------
# mealie-mcp configuration. Copy to .env (or paste into the TrueNAS app YAML)
# and fill in the values marked REQUIRED. Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- Mealie (REQUIRED) ---
MEALIE_URL=https://mealie.crashtech.co.uk
# Mealie > Profile > API Tokens. Keep secret.
MEALIE_API_TOKEN=

# --- Public address of this MCP server (REQUIRED) ---
# Must be the HTTPS URL your AI apps use, without the /mcp path.
PUBLIC_BASE_URL=https://mcp.crashtech.co.uk
MCP_PATH=/mcp

# --- Authentication (REQUIRED for internet exposure) ---
AUTH_MODE=oauth
# The password you type on the "Authorise access to your Mealie" page when
# connecting Claude or ChatGPT. Min 12 chars. Use a long random passphrase.
OWNER_PASSWORD=
# Signs OAuth tokens. Min 32 chars. Generate: openssl rand -hex 32
# Changing it signs out every connected client.
AUTH_SECRET=
# Optional: comma-separated long random bearer tokens for scripts/other MCP
# clients, e.g. Claude Code with --header (min 32 chars each). Leave empty if you only use OAuth.
STATIC_TOKENS=
# Hosts allowed as OAuth redirect targets.
OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,chat.openai.com,claude.ai,claude.com
# Allow http://localhost:<port> sign-in callbacks for apps on your own computer
# (Claude Code CLI, MCP Inspector).
OAUTH_ALLOW_LOOPBACK_REDIRECTS=true

# --- Import policy ---
# Domains recipes may be imported from. "*" = any public https site
# (LAN / private addresses are always refused).
IMPORT_ALLOWED_DOMAINS=hellofresh.co.uk,pinchofnom.com
# true = every import tool only previews (nothing is written to Mealie)
DRY_RUN=false
BULK_IMPORT_MAX=50
MEALIE_IMPORT_INCLUDE_TAGS=true

# --- Phone capture app (https://<your-host>/capture) ---
# Anthropic API key used to read recipe photos (console.anthropic.com). Billed per
# use, separately from a Claude subscription. Leave empty to disable /capture.
CLAUDE_API_TOKEN=
CLAUDE_MODEL=claude-opus-5-5
CAPTURE_MAX_IMAGES=20

# --- Timeouts / limits ---
MEALIE_TIMEOUT_SECONDS=30
MEALIE_IMPORT_TIMEOUT_SECONDS=120
HELLOFRESH_TIMEOUT_SECONDS=20
HELLOFRESH_MIN_INTERVAL_SECONDS=1
RATE_LIMIT_PER_SECOND=5
RATE_LIMIT_BURST=30

# --- Server ---
PORT=8000
LOG_LEVEL=INFO
# json or text
LOG_FORMAT=json
